# Copy to backend/.env. Never commit credentials.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_MODEL=DeepSeek-V4.1-Flash-B300
DEEPSEEK_BASE_URL=https://api.console.lablup.ai/v1
# For Lablup-issued credentials, use both of these instead:
# DEEPSEEK_BASE_URL=https://api.console.lablup.ai/v1
# DEEPSEEK_MODEL=DeepSeek-V4.1-Flash-B300
# Real mode: missing credentials/provider errors fail clearly. Set DEMO_MODE=true only for explicit demos.
DEMO_MODE=false
ALLOW_MOCK_FALLBACK=false

# World Labs uses existing Supabase Auth and the existing Supabase PostgreSQL DB.
# All of the following are backend-only. Do not use VITE_ for service/provider secrets.
WLT_API_KEY=
WORLD_GENERATION_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Dates, model, 3-per-account reservations, rates and global credit budget live
# in the existing DB after applying frontend/supabase/004_world_generation_allowance.sql.
# No Redis, SQLite, anonymous session secret or generation access code is required.

# MemoryCast: no narration calls until both this flag and DB settings are enabled.
# Reuses existing OpenAI/Lablup and Supabase server-only credentials.
MEMORYCAST_LIVE_ENABLED=false
