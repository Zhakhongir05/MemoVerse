# Copy to backend/.env. Never commit credentials.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_MODEL=DeepSeek-V4.1-Flash-B300
DEEPSEEK_BASE_URL=https://api.console.lablup.ai/v1
# For Lablup-issued credentials, use both of these instead:
# DEEPSEEK_BASE_URL=https://api.console.lablup.ai/v1
# DEEPSEEK_MODEL=DeepSeek-V4.1-Flash-B300
# Real mode: missing credentials/provider errors fail clearly. Set DEMO_MODE=true only for explicit demos.
DEMO_MODE=false
ALLOW_MOCK_FALLBACK=false

# Paid World Labs generation stays disabled until explicitly approved.
WLT_API_KEY=
WORLD_GENERATION_ENABLED=false
WORLD_GENERATION_ACCESS_TOKEN=
WORLD_LABS_MODEL=marble-1.1
WORLD_MAX_JOBS=1
# Durable Redis REST (required on Vercel); never use VITE_ for these.
WORLD_REDIS_REST_URL=
WORLD_REDIS_REST_TOKEN=
# Alternative for a long-running host with persistent disk, not Vercel:
# WORLD_JOB_DB=/absolute/persistent/path/world-jobs.sqlite
