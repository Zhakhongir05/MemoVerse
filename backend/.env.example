# Copy to backend/.env. Never commit credentials.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# For Lablup-issued credentials, use both of these instead:
# DEEPSEEK_BASE_URL=https://api.console.lablup.ai/v1
# DEEPSEEK_MODEL=DeepSeek-V4.1-Flash-B300
# Default: no provider calls, explicitly labeled demo response.
DEMO_MODE=true
ALLOW_MOCK_FALLBACK=true
