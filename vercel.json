{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm ci --prefix frontend",
  "buildCommand": "python3 scripts/inspect_world_jobs.py && env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,docs/**,backend/tests/**,backend/test_images/**,**/.env*,**/.venv/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    }
  ],
  "git": {
    "deploymentEnabled": true
  },
  "ignoreCommand": "exit 1"
}
